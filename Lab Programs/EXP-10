# Playfair Encryption Using Given Matrix

matrix = "MFHIKUNOPQZVWXYELARGDSTBC"

text = input("Enter plaintext: ").upper()
text = "".join(ch for ch in text if ch.isalpha()).replace("J", "I")

# Prepare pairs
prepared = ""
i = 0

while i < len(text):
    a = text[i]

    if i + 1 >= len(text):
        b = "X"
        i += 1
    elif text[i] == text[i + 1]:
        b = "X"
        i += 1
    else:
        b = text[i + 1]
        i += 2

    prepared += a + b

cipher = ""

for i in range(0, len(prepared), 2):
    a, b = prepared[i], prepared[i + 1]
    p1, p2 = matrix.index(a), matrix.index(b)
    r1, c1 = divmod(p1, 5)
    r2, c2 = divmod(p2, 5)

    if r1 == r2:
        cipher += matrix[r1*5 + (c1+1)%5]
        cipher += matrix[r2*5 + (c2+1)%5]
    elif c1 == c2:
        cipher += matrix[((r1+1)%5)*5 + c1]
        cipher += matrix[((r2+1)%5)*5 + c2]
    else:
        cipher += matrix[r1*5 + c2]
        cipher += matrix[r2*5 + c1]

print("Prepared text:", prepared)
print("Ciphertext:", cipher)
