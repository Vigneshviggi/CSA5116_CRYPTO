# Playfair Cipher Decryption

key = input("Enter key: ").upper().replace("J", "I")
text = input("Enter ciphertext: ").upper().replace("J", "I")

alphabet = "ABCDEFGHIKLMNOPQRSTUVWXYZ"
matrix = ""

for ch in key + alphabet:
    if ch.isalpha() and ch not in matrix:
        matrix += ch

plain = ""

for i in range(0, len(text), 2):
    a, b = text[i], text[i + 1]
    p1, p2 = matrix.index(a), matrix.index(b)
    r1, c1 = divmod(p1, 5)
    r2, c2 = divmod(p2, 5)

    if r1 == r2:
        plain += matrix[r1*5 + (c1-1)%5]
        plain += matrix[r2*5 + (c2-1)%5]
    elif c1 == c2:
        plain += matrix[((r1-1)%5)*5 + c1]
        plain += matrix[((r2-1)%5)*5 + c2]
    else:
        plain += matrix[r1*5 + c2]
        plain += matrix[r2*5 + c1]

print("Plaintext:", plain)
